<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="foodBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#f8fafc"/>
    </linearGradient>
    <linearGradient id="cardBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#f1f5f9"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#foodBg)"/>

  <!-- Top Navbar -->
  <rect x="0" y="0" width="1200" height="90" fill="#ffffff" filter="drop-shadow(0 2px 8px rgba(0,0,0,0.06))"/>
  
  <!-- Logo -->
  <circle cx="80" cy="45" r="28" fill="#003566"/>
  <path d="M72 32 V58 M80 32 V58 M88 32 V58 M70 58 H90" stroke="#ffffff" stroke-width="3" stroke-linecap="round"/>
  <text x="125" y="54" fill="#003566" font-family="sans-serif" font-weight="900" font-size="26">FOOD CORNER</text>

  <!-- Search Bar -->
  <rect x="380" y="25" width="480" height="42" rx="6" fill="#ffffff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="410" y="51" fill="#64748b" font-family="sans-serif" font-size="14">Search</text>

  <!-- Nav Icons -->
  <text x="920" y="52" fill="#1e293b" font-family="sans-serif" font-weight="bold" font-size="13">Offers</text>
  <text x="980" y="52" fill="#1e293b" font-family="sans-serif" font-weight="bold" font-size="13">Help</text>
  <text x="1040" y="52" fill="#1e293b" font-family="sans-serif" font-weight="bold" font-size="13">Cart</text>
  <text x="1100" y="52" fill="#1e293b" font-family="sans-serif" font-weight="bold" font-size="13">Sign In</text>

  <!-- Category Pills Row -->
  <g transform="translate(40, 110)">
    <rect x="0" y="0" width="100" height="120" rx="50" fill="#ffffff" stroke="#e2e8f0" filter="drop-shadow(0 4px 6px rgba(0,0,0,0.04))"/>
    <circle cx="50" cy="45" r="32" fill="#fbbf24"/>
    <text x="50" y="100" text-anchor="middle" fill="#0f172a" font-family="sans-serif" font-weight="bold" font-size="14">All</text>

    <rect x="120" y="0" width="100" height="120" rx="50" fill="#ffffff" stroke="#e2e8f0" filter="drop-shadow(0 4px 6px rgba(0,0,0,0.04))"/>
    <circle cx="170" cy="45" r="32" fill="#10b981"/>
    <text x="170" y="100" text-anchor="middle" fill="#0f172a" font-family="sans-serif" font-weight="bold" font-size="14">Veg</text>

    <rect x="240" y="0" width="100" height="120" rx="50" fill="#ffffff" stroke="#e2e8f0" filter="drop-shadow(0 4px 6px rgba(0,0,0,0.04))"/>
    <circle cx="290" cy="45" r="32" fill="#ef4444"/>
    <text x="290" y="100" text-anchor="middle" fill="#0f172a" font-family="sans-serif" font-weight="bold" font-size="14">Non Veg</text>

    <rect x="360" y="0" width="100" height="120" rx="50" fill="#ffffff" stroke="#e2e8f0" filter="drop-shadow(0 4px 6px rgba(0,0,0,0.04))"/>
    <circle cx="410" cy="45" r="32" fill="#3b82f6"/>
    <text x="410" y="100" text-anchor="middle" fill="#0f172a" font-family="sans-serif" font-weight="bold" font-size="14">Meals</text>

    <rect x="480" y="0" width="100" height="120" rx="50" fill="#ffffff" stroke="#e2e8f0" filter="drop-shadow(0 4px 6px rgba(0,0,0,0.04))"/>
    <circle cx="530" cy="45" r="32" fill="#f97316"/>
    <text x="530" y="100" text-anchor="middle" fill="#0f172a" font-family="sans-serif" font-weight="bold" font-size="14">Soups</text>
  </g>

  <!-- Main Course Section -->
  <text x="50" y="280" fill="#0f172a" font-family="sans-serif" font-weight="extrabold" font-size="24">Main Course</text>

  <!-- Food Card 1 -->
  <g transform="translate(50, 300)">
    <rect x="0" y="0" width="240" height="320" rx="12" fill="url(#cardBg)" filter="drop-shadow(0 8px 16px rgba(0,0,0,0.08))"/>
    <rect x="0" y="0" width="240" height="170" rx="12" fill="#fb923c"/>
    <text x="20" y="200" fill="#0f172a" font-family="sans-serif" font-weight="bold" font-size="16">Aloo Gobhi</text>
    <text x="220" y="200" text-anchor="end" fill="#0f172a" font-family="sans-serif" font-weight="bold" font-size="15">₹90/-</text>
    <rect x="0" y="260" width="240" height="60" rx="8" fill="#000000"/>
    <text x="120" y="296" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-weight="bold" font-size="16">Order</text>
  </g>

  <!-- Food Card 2 -->
  <g transform="translate(320, 300)">
    <rect x="0" y="0" width="240" height="320" rx="12" fill="url(#cardBg)" filter="drop-shadow(0 8px 16px rgba(0,0,0,0.08))"/>
    <rect x="0" y="0" width="240" height="170" rx="12" fill="#84cc16"/>
    <text x="20" y="200" fill="#0f172a" font-family="sans-serif" font-weight="bold" font-size="16">Jeera Aloo</text>
    <text x="220" y="200" text-anchor="end" fill="#0f172a" font-family="sans-serif" font-weight="bold" font-size="15">₹80/-</text>
    <rect x="0" y="260" width="240" height="60" rx="8" fill="#000000"/>
    <text x="120" y="296" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-weight="bold" font-size="16">Order</text>
  </g>

  <!-- Food Card 3 -->
  <g transform="translate(590, 300)">
    <rect x="0" y="0" width="240" height="320" rx="12" fill="url(#cardBg)" filter="drop-shadow(0 8px 16px rgba(0,0,0,0.08))"/>
    <rect x="0" y="0" width="240" height="170" rx="12" fill="#ea580c"/>
    <text x="20" y="200" fill="#0f172a" font-family="sans-serif" font-weight="bold" font-size="16">Dum Aloo</text>
    <text x="220" y="200" text-anchor="end" fill="#0f172a" font-family="sans-serif" font-weight="bold" font-size="15">₹90/-</text>
    <rect x="0" y="260" width="240" height="60" rx="8" fill="#000000"/>
    <text x="120" y="296" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-weight="bold" font-size="16">Order</text>
  </g>
</svg>
