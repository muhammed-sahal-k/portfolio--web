<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="odinBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#020617"/>
    </linearGradient>
    <linearGradient id="odinGold" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#cc9900"/>
      <stop offset="100%" stop-color="#ffcc00"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#odinBg)"/>

  <!-- Header Nav -->
  <rect x="0" y="0" width="1200" height="90" fill="#090d16"/>
  <text x="80" y="55" fill="url(#odinGold)" font-family="sans-serif" font-weight="900" font-size="28">THE ODIN PROJECT</text>
  <text x="900" y="53" fill="#94a3b8" font-family="sans-serif" font-weight="bold" font-size="15">All Paths</text>
  <text x="1000" y="53" fill="#94a3b8" font-family="sans-serif" font-weight="bold" font-size="15">About</text>
  <text x="1080" y="53" fill="#94a3b8" font-family="sans-serif" font-weight="bold" font-size="15">Community</text>

  <!-- Hero Content -->
  <text x="600" y="220" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-weight="extrabold" font-size="46">High Quality Coding Curriculum</text>
  <text x="600" y="275" text-anchor="middle" fill="#94a3b8" font-family="sans-serif" font-size="20">Learn Full Stack Web Development For Free with Open Source Community</text>

  <rect x="490" y="320" width="220" height="54" rx="27" fill="url(#odinGold)"/>
  <text x="600" y="354" text-anchor="middle" fill="#000000" font-family="sans-serif" font-weight="bold" font-size="18">View Curriculum</text>

  <!-- Cards Grid -->
  <g transform="translate(150, 420)">
    <rect x="0" y="0" width="260" height="190" rx="16" fill="#1e293b" stroke="#334155"/>
    <text x="130" y="70" text-anchor="middle" fill="url(#odinGold)" font-family="sans-serif" font-weight="bold" font-size="20">Foundations</text>
    <text x="130" y="110" text-anchor="middle" fill="#94a3b8" font-family="sans-serif" font-size="14">HTML, CSS, JS Basics</text>

    <rect x="320" y="0" width="260" height="190" rx="16" fill="#1e293b" stroke="#334155"/>
    <text x="450" y="70" text-anchor="middle" fill="url(#odinGold)" font-family="sans-serif" font-weight="bold" font-size="20">Full Stack JS</text>
    <text x="450" y="110" text-anchor="middle" fill="#94a3b8" font-family="sans-serif" font-size="14">React, Node, Express, Mongo</text>

    <rect x="640" y="0" width="260" height="190" rx="16" fill="#1e293b" stroke="#334155"/>
    <text x="770" y="70" text-anchor="middle" fill="url(#odinGold)" font-family="sans-serif" font-weight="bold" font-size="20">Full Stack Ruby</text>
    <text x="770" y="110" text-anchor="middle" fill="#94a3b8" font-family="sans-serif" font-size="14">Ruby on Rails & SQL</text>
  </g>
</svg>
