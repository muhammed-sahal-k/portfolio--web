<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="todoBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f3f4f6"/>
      <stop offset="100%" stop-color="#e5e7eb"/>
    </linearGradient>
    <linearGradient id="containerGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1d68a7"/>
      <stop offset="100%" stop-color="#174f80"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#todoBg)"/>

  <!-- Todo Main Blue Card Container -->
  <rect x="250" y="90" width="700" height="495" rx="16" fill="url(#containerGrad)" filter="drop-shadow(0 20px 30px rgba(0,0,0,0.15))"/>

  <!-- Title -->
  <text x="600" y="160" text-anchor="middle" fill="#b91c1c" font-family="serif" font-weight="bold" font-size="38">todolist</text>

  <!-- Input Row -->
  <rect x="290" y="200" width="410" height="50" rx="8" fill="#f9fafb" stroke="#d1d5db"/>
  <text x="310" y="232" fill="#6b7280" font-family="sans-serif" font-size="16">add new item</text>

  <!-- Add Button -->
  <rect x="715" y="200" width="55" height="50" rx="8" fill="#047857"/>
  <text x="742" y="230" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-size="13">Add</text>

  <!-- Clear All Button -->
  <rect x="780" y="200" width="70" height="50" rx="8" fill="#b91c1c"/>
  <text x="815" y="230" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-size="13">Clear All</text>

  <!-- Task Item 1 -->
  <rect x="290" y="275" width="400" height="50" rx="8" fill="#1e588c"/>
  <text x="315" y="306" fill="#ffffff" font-family="sans-serif" font-size="15">add color theam</text>
  <rect x="708" y="280" width="50" height="40" rx="6" fill="#113e66"/>
  <text x="733" y="305" text-anchor="middle" fill="#93c5fd" font-family="sans-serif" font-size="12">Edit</text>
  <rect x="765" y="280" width="60" height="40" rx="6" fill="#113e66"/>
  <text x="795" y="305" text-anchor="middle" fill="#93c5fd" font-family="sans-serif" font-size="12">Delete</text>

  <!-- Task Item 2 -->
  <rect x="290" y="340" width="400" height="50" rx="8" fill="#1e588c"/>
  <text x="315" y="371" fill="#ffffff" font-family="sans-serif" font-size="15">create a portfolio website</text>
  <rect x="708" y="345" width="50" height="40" rx="6" fill="#113e66"/>
  <text x="733" y="370" text-anchor="middle" fill="#93c5fd" font-family="sans-serif" font-size="12">Edit</text>
  <rect x="765" y="345" width="60" height="40" rx="6" fill="#113e66"/>
  <text x="795" y="370" text-anchor="middle" fill="#93c5fd" font-family="sans-serif" font-size="12">Delete</text>

  <!-- Task Item 3 -->
  <rect x="290" y="405" width="400" height="50" rx="8" fill="#1e588c"/>
  <text x="315" y="436" fill="#ffffff" font-family="sans-serif" font-size="15">study english</text>
  <rect x="708" y="410" width="50" height="40" rx="6" fill="#113e66"/>
  <text x="733" y="435" text-anchor="middle" fill="#93c5fd" font-family="sans-serif" font-size="12">Edit</text>
  <rect x="765" y="410" width="60" height="40" rx="6" fill="#113e66"/>
  <text x="795" y="435" text-anchor="middle" fill="#93c5fd" font-family="sans-serif" font-size="12">Delete</text>

  <!-- Task Item 4 -->
  <rect x="290" y="470" width="400" height="50" rx="8" fill="#1e588c"/>
  <text x="315" y="501" fill="#ffffff" font-family="sans-serif" font-size="15">shedule shooting</text>
  <rect x="708" y="475" width="50" height="40" rx="6" fill="#113e66"/>
  <text x="733" y="500" text-anchor="middle" fill="#93c5fd" font-family="sans-serif" font-size="12">Edit</text>
  <rect x="765" y="475" width="60" height="40" rx="6" fill="#113e66"/>
  <text x="795" y="500" text-anchor="middle" fill="#93c5fd" font-family="sans-serif" font-size="12">Delete</text>
</svg>
