<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b0b14"/>
      <stop offset="100%" stop-color="#05050a"/>
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#121324"/>
      <stop offset="100%" stop-color="#0d0d1a"/>
    </linearGradient>
    <linearGradient id="btnGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#6366f1"/>
      <stop offset="100%" stop-color="#8b5cf6"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#bg)"/>
  
  <!-- Logo Icon -->
  <rect x="570" y="100" width="60" height="60" rx="16" fill="#8b5cf6"/>
  <path d="M588 130 L596 138 L612 122" stroke="#ffffff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  
  <!-- Brand Title -->
  <text x="600" y="210" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-weight="bold" font-size="36">ApexTasks</text>
  <text x="600" y="245" text-anchor="middle" fill="#9ca3af" font-family="sans-serif" font-size="16">Organize, track, and complete your tasks seamlessly.</text>
  
  <!-- Login Card Container -->
  <rect x="420" y="280" width="360" height="320" rx="20" fill="url(#cardGrad)" stroke="#1e1e38" stroke-width="1.5"/>
  <text x="600" y="335" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-weight="bold" font-size="20">Log in to your account</text>
  
  <!-- Input 1 -->
  <text x="450" y="375" fill="#6b7280" font-family="sans-serif" font-weight="bold" font-size="11">EMAIL ADDRESS</text>
  <rect x="450" y="385" width="300" height="42" rx="10" fill="#e0e7ff"/>
  <text x="475" y="411" fill="#374151" font-family="sans-serif" font-size="14">sahalkmohammed956@gmail.com</text>

  <!-- Input 2 -->
  <text x="450" y="455" fill="#6b7280" font-family="sans-serif" font-weight="bold" font-size="11">PASSWORD</text>
  <rect x="450" y="465" width="300" height="42" rx="10" fill="#e0e7ff"/>
  <text x="475" y="491" fill="#374151" font-family="sans-serif" font-size="16">••••••••</text>
  
  <!-- Button -->
  <rect x="450" y="530" width="300" height="46" rx="12" fill="url(#btnGrad)"/>
  <text x="600" y="558" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-weight="bold" font-size="15">Log In →</text>
</svg>
