<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bmsBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1a0928"/>
      <stop offset="100%" stop-color="#090212"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#bmsBg)"/>
  
  <!-- Top Nav -->
  <rect x="0" y="0" width="1200" height="80" fill="#12061c"/>
  <text x="60" y="50" fill="#ffffff" font-family="sans-serif" font-weight="bold" font-size="30">book<tspan fill="#e50914">my</tspan>show</text>
  <rect x="300" y="24" width="400" height="36" rx="6" fill="#240d36"/>
  <text x="320" y="48" fill="#a88bbd" font-family="sans-serif" font-size="14">Search for Movies, Events, Plays, Sports...</text>

  <!-- Hero Cinema Banner -->
  <rect x="60" y="110" width="1080" height="280" rx="16" fill="#2a0845"/>
  <text x="120" y="200" fill="#ffffff" font-family="sans-serif" font-weight="extrabold" font-size="42">BOOKMYSHOW CLONE</text>
  <text x="120" y="245" fill="#e50914" font-family="sans-serif" font-weight="bold" font-size="20">Recommended Movies & Online Ticket Booking System</text>

  <rect x="120" y="285" width="180" height="48" rx="8" fill="#e50914"/>
  <text x="210" y="315" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-weight="bold" font-size="16">Book Tickets</text>

  <!-- Movie Cards Row -->
  <text x="60" y="435" fill="#ffffff" font-family="sans-serif" font-weight="bold" font-size="24">Recommended Movies</text>
  
  <g transform="translate(60, 455)">
    <rect x="0" y="0" width="180" height="180" rx="12" fill="#3b0f5c"/>
    <text x="90" y="100" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-weight="bold" font-size="16">Action Thriller</text>

    <rect x="220" y="0" width="180" height="180" rx="12" fill="#3b0f5c"/>
    <text x="310" y="100" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-weight="bold" font-size="16">Sci-Fi Blockbuster</text>

    <rect x="440" y="0" width="180" height="180" rx="12" fill="#3b0f5c"/>
    <text x="530" y="100" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-weight="bold" font-size="16">Drama & Romance</text>

    <rect x="660" y="0" width="180" height="180" rx="12" fill="#3b0f5c"/>
    <text x="750" y="100" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-weight="bold" font-size="16">Animation 3D</text>

    <rect x="880" y="0" width="180" height="180" rx="12" fill="#3b0f5c"/>
    <text x="970" y="100" text-anchor="middle" fill="#ffffff" font-family="sans-serif" font-weight="bold" font-size="16">Live Comedy</text>
  </g>
</svg>
