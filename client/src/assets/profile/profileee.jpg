<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1a0b2e"/>
      <stop offset="50%" stop-color="#0c102b"/>
      <stop offset="100%" stop-color="#050816"/>
    </linearGradient>
    <linearGradient id="shirtGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00b4d8"/>
      <stop offset="100%" stop-color="#0077b6"/>
    </linearGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#111111"/>
      <stop offset="100%" stop-color="#222222"/>
    </linearGradient>
    <radialGradient id="faceGlow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#ffdfc4"/>
      <stop offset="100%" stop-color="#c68b59"/>
    </radialGradient>
  </defs>
  <!-- Background -->
  <rect width="600" height="600" fill="url(#bgGrad)"/>
  <path d="M50 0 V600 M150 0 V600 M250 0 V600 M350 0 V600 M450 0 V600 M550 0 V600" stroke="#2b1d42" stroke-width="4"/>
  <path d="M0 100 H600 M0 200 H600 M0 300 H600 M0 400 H600 M0 500 H600" stroke="#2b1d42" stroke-width="4"/>

  <!-- Body / Blue Shirt -->
  <path d="M150 600 C150 480 200 410 300 410 C400 410 450 480 450 600 Z" fill="url(#shirtGrad)"/>
  <path d="M260 410 L300 480 L340 410" stroke="#005f73" stroke-width="6" fill="none"/>

  <!-- Face & Neck -->
  <rect x="270" y="350" width="60" height="70" fill="#c68b59" rx="10"/>
  <ellipse cx="300" cy="270" rx="90" ry="110" fill="url(#faceGlow)"/>

  <!-- Wavy Hair -->
  <path d="M200 240 C190 150 240 100 300 100 C360 100 410 150 400 240 C420 200 410 120 370 100 C340 80 260 80 230 100 C190 120 180 200 200 240 Z" fill="#1a100c"/>

  <!-- Sunglasses -->
  <rect x="230" y="240" width="60" height="35" rx="8" fill="url(#glassGrad)" stroke="#ffd700" stroke-width="2"/>
  <rect x="310" y="240" width="60" height="35" rx="8" fill="url(#glassGrad)" stroke="#ffd700" stroke-width="2"/>
  <line x1="290" y1="250" x2="310" y2="250" stroke="#ffd700" stroke-width="3"/>

  <!-- Mustache -->
  <path d="M275 325 Q300 330 325 325 Q300 320 275 325" fill="#2a1a14"/>
</svg>
